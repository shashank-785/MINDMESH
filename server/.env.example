PORT=3000

# Optional OpenAI-compatible chat completions provider.
# Both values must be present before the server will use the provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional comma-separated browser origins. The default is * (no credentials).
CORS_ORIGIN=*

# Optional Supabase Auth and managed account storage.
# SUPABASE_ANON_KEY is public and delivered to the browser by /api/config.
# Keep SUPABASE_SERVICE_ROLE_KEY server-only.
# Never put SUPABASE_SERVICE_ROLE_KEY in the browser or commit it to source control.
# This starter reads process environment variables; export these values before npm start.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
